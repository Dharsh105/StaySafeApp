<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="#E9DDF5">

    <!-- TITLE -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Notification and Sound"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#111"
        android:layout_marginBottom="20dp"/>

    <!-- SOUND SWITCH -->
    <Switch
        android:id="@+id/soundSwitch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Enable Sound"/>

    <!-- VIBRATION SWITCH -->
    <Switch
        android:id="@+id/vibrationSwitch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Enable Vibration"
        android:layout_marginTop="15dp"/>

    <!-- SELECT TONE BUTTON -->
    <Button
        android:id="@+id/btnSelectTone"
        android:text="Select Notification Tone"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:layout_marginTop="36dp"
        android:layout_alignParentEnd="true"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:background="@drawable/bg_button_purple" />

    <!-- SELECTED TONE -->
    <TextView
        android:id="@+id/tvSelectedTone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Tone : Default"
        android:textSize="16sp"
        android:layout_marginTop="15dp"/>

</LinearLayout>