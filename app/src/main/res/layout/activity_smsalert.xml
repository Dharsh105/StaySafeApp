<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E9DDF5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- TITLE -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📩 SMS Alert"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#6A1B9A"
            android:layout_marginBottom="20dp"/>

        <!-- CARD -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:background="#F3E5F5"
            android:elevation="8dp">

            <!-- INFO -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Select a contact and send alert quickly."
                android:textColor="#555"
                android:textSize="14sp"
                android:layout_marginBottom="15dp"/>

            <!-- CONTACT -->
            <TextView
                android:id="@+id/txtContact"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="No Contact Selected"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#333"
                android:padding="12dp"
                android:background="#FFFFFF"
                android:layout_marginBottom="20dp"/>

            <!-- SELECT BUTTON -->
            <Button
                android:id="@+id/btnSelectContact"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginTop="36dp"
                android:layout_alignParentEnd="true"
                android:text="SELECT CONTACTS"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:background="@drawable/bg_button_purple" />

            <!-- SMS BUTTON -->
            <Button
                android:id="@+id/btnSendSMS"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginTop="36dp"
                android:layout_alignParentEnd="true"
                android:text="SEND SMS ALERT"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:background="@drawable/bg_button_purple" />

            <!-- EMAIL BUTTON -->
            <Button
                android:id="@+id/btnSendEmail"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginTop="36dp"
                android:layout_alignParentEnd="true"
                android:text="SEND EMAIL ALERT"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:background="@drawable/bg_button_purple" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>